# 年会 AI 工具箱 Nginx 配置
# 放到 /etc/nginx/sites-available/nianhui 然后 ln -s 到 sites-enabled

server {
    listen 80;
    server_name 你的域名.com;

    # 强制 HTTPS（申请证书后取消注释）
    # return 301 https://$server_name$request_uri;
}

