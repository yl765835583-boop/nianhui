<view class="container">
  <view class="hero">
    <text class="hero-title">✅ 扫码签到</text>
    <text class="hero-desc">扫大屏二维码，签到上大屏</text>
  </view>

  <block wx:if="{{!signed}}">
    <view class="card">
      <view class="card-title">填写签到信息</view>
      <input class="input" placeholder="你的姓名 *" value="{{name}}" bindinput="onNameInput" style="margin-bottom:12rpx;" />
      <input class="input" placeholder="部门（可选）" value="{{dept}}" bindinput="onDeptInput" style="margin-bottom:16rpx;" />
      <button class="btn {{scanned ? 'btn-success' : 'btn-warning'}}" style="width:100%;" bindtap="scanCode" loading="{{scanning}}">
        {{scanned ? '✅ 已识别大屏二维码' : '📷 扫大屏二维码'}}
      </button>
      <button class="btn btn-primary" style="width:100%;margin-top:16rpx;" bindtap="doSignin" loading="{{submitting}}">✅ 立即签到</button>
    </view>
  </block>

  <view class="card" wx:if="{{signed}}" style="text-align:center;">
    <text style="font-size:80rpx;">🎉</text>
    <view style="font-size:32rpx;font-weight:700;color:#10b981;margin:16rpx 0;">签到成功！</view>
    <view style="color:#8892b0;font-size:28rpx;">{{signedName}}，欢迎参加年会！</view>
    <view style="color:#9ca3af;font-size:24rpx;margin-top:8rpx;">当前已签到 {{signedTotal}} 人</view>
    <button class="btn" style="width:100%;margin-top:24rpx;" bindtap="resign">再次签到</button>
  </view>
</view>
