.container { padding: 20rpx; min-height: 100vh; background: linear-gradient(135deg, #1a1a2e, #16213e); }
.status-bar { text-align: center; padding: 40rpx 0; }
.status-badge { display: inline-block; padding: 12rpx 40rpx; border-radius: 40rpx; font-size: 32rpx; font-weight: bold; }
.status-badge.active { background: linear-gradient(135deg, #f59e0b, #ef4444); color: #fff; animation: pulse 1.5s infinite; }
.status-badge.inactive { background: rgba(255,255,255,0.1); color: #8892b0; }
.prize-title { display: block; font-size: 36rpx; color: #ffd93d; margin-top: 20rpx; }
.stats { display: flex; justify-content: center; gap: 60rpx; padding: 40rpx 0; }
.stat-item { text-align: center; }
.stat-num { font-size: 72rpx; font-weight: bold; color: #6bcbff; }
.stat-num.highlight { color: #ff6b6b; }
.stat-label { font-size: 26rpx; color: #8892b0; margin-top: 8rpx; display: block; }
.winners-section { padding: 20rpx 0; }
.section-title { font-size: 34rpx; color: #ffd93d; font-weight: bold; padding: 20rpx 0; display: block; }
.winner-row { display: flex; justify-content: space-between; align-items: center; padding: 24rpx; margin: 12rpx 0; background: rgba(255,255,255,0.06); border-radius: 16rpx; border-left: 6rpx solid #ffd93d; }
.winner-info { flex: 1; }
.winner-name { font-size: 32rpx; color: #ffd93d; font-weight: bold; display: block; }
.winner-dept { font-size: 24rpx; color: #8892b0; }
.winner-prize { text-align: right; }
.prize-name { font-size: 28rpx; color: #ff6b6b; font-weight: bold; display: block; }
.prize-msg { font-size: 22rpx; color: #8892b0; font-style: italic; margin-top: 4rpx; display: block; }
.empty { text-align: center; padding: 80rpx 0; color: #8892b0; font-size: 28rpx; }
@keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.6; } }
