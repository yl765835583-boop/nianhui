# 年会 AI 工具箱 - 环境变量配置
# 复制此文件为 .env 并填入真实 Key

# 管理后台 Token（生产环境请务必修改）
ADMIN_TOKEN=nianhui-admin-2026

# 服务端口
PORT=3456

# AI 供应商 API Key（至少配置一个文本供应商）
MINIMAX_KEY=sk-api-xxx
DEEPSEEK_KEY=sk-xxx
QWEN_KEY=
ZHIPU_KEY=
DOUBAO_KEY=
KIMI_KEY=
WENXIN_KEY=
WENXIN_SECRET=

# 可选：语音供应商
XFYUN_APPID=
XFYUN_APIKEY=
XFYUN_APISECRET=
VOLCANO_KEY=
VOLCANO_APPID=

# 微信 OAuth 配置（扫码签到——微信开放平台/公众号）
WECHAT_APPID=
WECHAT_APPSECRET=
# 授权范围：snsapi_base 静默授权(仅 openid) / snsapi_userinfo 需用户同意(可拿昵称头像)
WECHAT_SCOPE=snsapi_userinfo

# 微信小程序（生成小程序码 / 扫码签到）
MINIAPP_APPID=
MINIAPP_SECRET=

# 公开访问地址（部署到公网时设置，用于微信 OAuth 回调）
PUBLIC_URL=
